{
  "author": "Alejandro Campos",
  "build": {
    "appId": "com.alcaur.assis",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**/*"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": false,
      "shortcutName": "ASSIS"
    },
    "productName": "ASSIS",
    "win": {
      "artifactName": "ASSIS-Instalador-${version}.exe",
      "target": "nsis"
    }
  },
  "description": "ASSIS - Asistencia Escolar (Juan Miguel Roo). App de escritorio 100% local con respaldo manual en GitHub.",
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "license": "MIT",
  "main": "main.js",
  "name": "assis",
  "scripts": {
    "dist": "electron-builder --win",
    "start": "electron ."
  },
  "version": "1.0.1"
}